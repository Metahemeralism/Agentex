{
 "id": "acm-sigconf",
 "name": "ACM conference proceedings (acmart, TAPS)",
 "checked": "2026-10-26",
 "sources": [
  "https://authors.acm.org/proceedings/production-information/preparing-your-article-with-latex",
  "https://authors.acm.org/proceedings/production-information/accepted-latex-packages",
  "https://www.acm.org/publications/policies/new-acm-policy-on-authorship"
 ],
 "verified": true,
 "double_blind": true,
 "pages": {
  "submission": null,
  "camera-ready": null,
  "uncounted": []
 },
 "style": {
  "file": "acmart.cls",
  "sha256": null,
  "url": "https://ctan.org/pkg/acmart",
  "why": "ACM article template"
 },
 "named_if": "\\\\documentclass\\s*(?:\\[(?![^\\]]*\\banonymous\\b)[^\\]]*\\])?\\s*\\{acmart\\}",
 "switch": {
  "submission": "\\documentclass[manuscript,anonymous,review]{acmart} + \\setcopyright{none} (or the format your call names)",
  "camera-ready": "\\documentclass[sigconf]{acmart} (drop manuscript/anonymous/review) + the rights-form commands"
 },
 "no_acks_in_submission": false,
 "required": [
  {
   "what": "\\setcopyright from the ACM rights form",
   "pattern": "\\\\setcopyright\\s*\\{(?!\\s*none\\s*\\})",
   "modes": [
    "camera-ready"
   ],
   "why": "ACM: after the rights form, add its LaTeX commands, replacing \\setcopyright{none}",
   "fix": "paste the rights block from the ACM rights-form e-mail; never invent the values"
  },
  {
   "what": "\\acmDOI",
   "pattern": "\\\\acmDOI\\s*\\{",
   "modes": [
    "camera-ready"
   ],
   "why": "part of the rights-form block",
   "fix": "paste the rights block from the ACM rights-form e-mail"
  },
  {
   "what": "\\acmConference or \\acmJournal",
   "pattern": "\\\\acm(?:Conference|Journal)\\b",
   "modes": [
    "camera-ready"
   ],
   "why": "acmart: an ACM paper should have either \\acmJournal or \\acmConference",
   "fix": "paste the rights block from the ACM rights-form e-mail"
  }
 ],
 "forbidden": [
  {
   "what": "manuscript class option",
   "pattern": "\\\\documentclass\\s*\\[[^\\]]*\\bmanuscript\\b[^\\]]*\\]\\s*\\{acmart\\}",
   "modes": [
    "camera-ready"
   ],
   "why": "ACM: remove \"manuscript\" so TAPS typesets the final format",
   "fix": "\\documentclass[sigconf]{acmart}"
  }
 ],
